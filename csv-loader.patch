     private static boolean inRange(Integer value, Integer min, Integer max) {
+        // An absent bound is not a constraint, so an unknown value still matches. Snapshots
+        // loaded from a CSV export leave ca, pa and reputation null, and an unfiltered search
+        // must still return those players. Matches the semantics used by the database services.
+        if (min == null && max == null) {
+            return true;
+        }
         return value != null && (min == null || value >= min) && (max == null || value <= max);
     }
 
